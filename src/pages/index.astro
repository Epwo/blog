---
import Base from "@/layouts/Base.astro";
import Signature from "@/components/Signature.astro";
import Tags from "@/components/Tags.astro";
import { getArticles, isWip, url } from "@/lib/articles";
import { formatMonth } from "@/lib/date";

const articles = await getArticles();
---

<Base>
  <section class="hero container">
    <h1 class="visually-hidden">Epwo</h1>
    <Signature class="hero-sig" />
    <p class="intro">
      Hi, I'm <strong>Ewann</strong> — an extroverted tech nerd, and proud of it. I write here about the
      things I build: machine learning experiments, self-hosted setups and side projects.
    </p>
    <p class="motto">The human fuel is passion.</p>
  </section>

  <section class="container" aria-labelledby="writing">
    <h2 id="writing" class="section-title">Writing</h2>
    <ol class="feed">
      {
        articles.map((a) => (
          <li>
            <a href={url(`articles/${a.id}/`)} class="item">
              <time datetime={a.data.date.toISOString()}>{formatMonth(a.data.date)}</time>
              <div class="body">
                <h3>{a.data.title}</h3>
                {a.data.summary && <p>{a.data.summary}</p>}
                <Tags tags={a.data.theme} wip={isWip(a)} />
              </div>
            </a>
          </li>
        ))
      }
    </ol>
    {articles.length === 0 && <p class="empty">Nothing here yet — come back soon.</p>}
  </section>
</Base>

<style>
  .hero {
    padding-top: 56px;
    padding-bottom: 40px;
  }
  .hero :global(.hero-sig) {
    width: min(300px, 75%);
    margin-left: -6%;
  }
  .intro {
    margin: 8px 0 0;
    font-size: 1.15rem;
    max-width: 34em;
  }
  .intro strong {
    font-weight: 600;
  }
  .motto {
    margin: 12px 0 0;
    color: var(--muted);
    font-style: italic;
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }

  .section-title {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 24px 0 8px;
  }

  .feed {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .feed li + li {
    border-top: 1px solid var(--border);
  }
  .item {
    display: grid;
    grid-template-columns: 88px 1fr;
    gap: 16px;
    padding: 22px 0;
  }
  time {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--muted);
    padding-top: 4px;
    white-space: nowrap;
  }
  h3 {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: -0.01em;
    transition: color 0.15s;
  }
  .item:hover h3 {
    color: var(--accent);
  }
  .body p {
    margin: 4px 0 10px;
    color: var(--muted);
    font-size: 0.975rem;
  }
  .empty {
    color: var(--muted);
  }

  @media (max-width: 560px) {
    .item {
      grid-template-columns: 1fr;
      gap: 2px;
    }
    time {
      padding-top: 0;
    }
  }
</style>
