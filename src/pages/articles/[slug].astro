---
import { render } from "astro:content";
import Base from "@/layouts/Base.astro";
import Tags from "@/components/Tags.astro";
import { getArticles, isWip, readingTime, url, type Article } from "@/lib/articles";
import { formatDate } from "@/lib/date";

export async function getStaticPaths() {
  const articles = await getArticles();
  return articles.map((article, i) => ({
    params: { slug: article.id },
    // The list is newest first, so "newer" sits before and "older" after.
    props: { article, newer: articles[i - 1], older: articles[i + 1] },
  }));
}

interface Props {
  article: Article;
  newer?: Article;
  older?: Article;
}

const { article, newer, older } = Astro.props;
const { title, date, summary, theme, image } = article.data;
const { Content } = await render(article);
---

<Base title={title} description={summary || undefined} image={image} type="article">
  <article class="container">
    <header class="head">
      <a href={url()} class="back">← All writing</a>
      <h1>{title}</h1>
      <p class="meta">
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        <span aria-hidden="true">·</span>
        <span>{readingTime(article)} min read</span>
      </p>
      <Tags tags={theme} wip={isWip(article)} />
      {summary && <p class="lede">{summary}</p>}
    </header>

    {image && <img class="cover" src={image} alt="" loading="eager" decoding="async" />}

    <div class="prose">
      <Content />
    </div>

    {
      (newer || older) && (
        <nav class="pager" aria-label="More articles">
          {older ? (
            <a href={url(`articles/${older.id}/`)} class="older">
              <span>Older</span>
              {older.data.title}
            </a>
          ) : (
            <span />
          )}
          {newer && (
            <a href={url(`articles/${newer.id}/`)} class="newer">
              <span>Newer</span>
              {newer.data.title}
            </a>
          )}
        </nav>
      )
    }
  </article>
</Base>

<style>
  .head {
    padding-top: 40px;
  }
  .back {
    font-size: 0.875rem;
    color: var(--muted);
  }
  .back:hover {
    color: var(--fg);
  }
  h1 {
    margin: 20px 0 8px;
    font-size: clamp(1.9rem, 5vw, 2.6rem);
    line-height: 1.15;
    letter-spacing: -0.025em;
    font-weight: 700;
    text-wrap: balance;
  }
  .meta {
    display: flex;
    gap: 8px;
    margin: 0 0 12px;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--muted);
  }
  .lede {
    margin: 24px 0 0;
    font-size: 1.15rem;
    color: var(--muted);
  }
  .cover {
    display: block;
    width: 100%;
    aspect-ratio: 2 / 1;
    object-fit: cover;
    border-radius: 12px;
    margin: 32px 0 8px;
    background: var(--bg-raised);
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-top: 64px;
  }
  .pager a {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 16px;
    border: 1px solid var(--border);
    border-radius: 10px;
    font-weight: 500;
    line-height: 1.35;
    transition: border-color 0.15s;
  }
  .pager a:hover {
    border-color: var(--accent);
  }
  .pager span {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
    font-weight: 400;
  }
  .newer {
    text-align: right;
    grid-column: 2;
  }
  @media (max-width: 560px) {
    .pager {
      grid-template-columns: 1fr;
    }
    .newer {
      grid-column: 1;
    }
  }

  /* Markdown body */
  .prose {
    margin-top: 24px;
    overflow-wrap: break-word;
  }
  .prose :global(h1),
  .prose :global(h2),
  .prose :global(h3),
  .prose :global(h4) {
    line-height: 1.3;
    letter-spacing: -0.015em;
    margin: 2.2em 0 0.6em;
    font-weight: 650;
  }
  .prose :global(h1) {
    font-size: 1.6rem;
  }
  .prose :global(h2) {
    font-size: 1.35rem;
  }
  .prose :global(h3) {
    font-size: 1.15rem;
  }
  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 1.1em;
  }
  .prose :global(li) {
    margin-bottom: 0.35em;
  }
  .prose :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }
  .prose :global(img) {
    display: block;
    margin: 1.8em auto;
    border-radius: 8px;
  }
  .prose :global(blockquote) {
    margin: 1.5em 0;
    padding: 0.2em 0 0.2em 1.1em;
    border-left: 3px solid var(--border);
    color: var(--muted);
  }
  .prose :global(hr) {
    border: 0;
    border-top: 1px solid var(--border);
    margin: 2.5em 0;
  }
  .prose :global(:not(pre) > code) {
    font-family: var(--font-mono);
    font-size: 0.88em;
    padding: 0.12em 0.38em;
    border-radius: 5px;
    background: var(--code-bg);
    border: 1px solid var(--border);
  }
  .prose :global(pre) {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    line-height: 1.6;
    padding: 16px 18px;
    border-radius: 10px;
    border: 1px solid var(--border);
    overflow-x: auto;
    margin: 1.5em 0;
  }
  .prose :global(table) {
    display: block;
    overflow-x: auto;
    border-collapse: collapse;
    margin: 1.5em 0;
    font-size: 0.95rem;
  }
  .prose :global(th),
  .prose :global(td) {
    border: 1px solid var(--border);
    padding: 6px 12px;
    text-align: left;
  }
  .prose :global(th) {
    background: var(--bg-raised);
  }
</style>
