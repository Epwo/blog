---
import Base from "@/layouts/Base.astro";
import { url } from "@/lib/articles";
---

<Base title="Not found">
  <section class="container">
    <h1>Nothing here.</h1>
    <p>This page doesn't exist, or it moved. <a href={url()}>Back to the homepage →</a></p>
  </section>
</Base>

<style>
  section {
    padding-top: 64px;
  }
  h1 {
    font-size: 2rem;
    letter-spacing: -0.02em;
    margin: 0 0 8px;
  }
  p {
    color: var(--muted);
  }
  a {
    color: var(--accent);
  }
</style>
